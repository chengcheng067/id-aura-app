/**
 * 服务端独立 TS 配置（与前端 tsconfig.json 隔离）：
 * ESM + NodeNext 解析，供 `npx tsc --noEmit -p server/tsconfig.json` 校验，
 * 运行时由 tsx 直接执行 TS 源码。
 */
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"]
}
